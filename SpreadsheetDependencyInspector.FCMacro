def get_column(cell):
    return ''.join([c for c in cell if not c.isdigit()])


def get_row(cell):
    row = ''.join([c for c in cell if c.isdigit()])
    if row == '':
        row = '1'
    return int(row)


def get_col_index(col_letters):
    col = 0
    for ch in col_letters:
        col = col * 26 + (ord(ch) - ord('A') + 1)
    return col


def addr_to_row_col(addr):
    col_letters = get_column(addr)
    row = get_row(addr)
    col = get_col_index(col_letters)
    return row, col


def cell_to_addr(row, col):
    # col: 1-based index
    letters = ""
    while col > 0:
        col, rem = divmod(col - 1, 26)
        letters = chr(ord('A') + rem) + letters
    return f"{letters}{row}"


def build_alias_map_for_all_sheets():
    alias_map = {}

    for sh in App.ActiveDocument.findObjects("Spreadsheet::Sheet"):
        sheet_name = sh.Name
        alias_map[sheet_name] = {}

        xml = sh.cells.Content
        if not xml:
            continue

        root = ET.fromstring(xml)

        for cell in root.findall("Cell"):
            addr = cell.get("address")
            alias = cell.get("alias")

            if alias:
                full_ref = f"{sheet_name}.{addr}"
                alias_map[sheet_name][alias] = full_ref

    return alias_map


def extract_raw_refs_for_graph(formula, sheet_name, alias_map):
    if not formula:
        return set()

    # '$' marque seulement une référence absolue ($A$1 = A1)
    formula = str(formula).replace("$", "")
    refs = set()

    # 0) Plages : A1:B5, datas.A1:B5, <<datas>>.A1:B5 (développées en cellules par normalize_refs)
    #    puis retirées de la formule, pour que leurs extrémités ne soient pas lues à nouveau seules
    range_pattern = r"(?:(<<[^>]+>>|[A-Za-z_][A-Za-z0-9_]*)\.)?\b([A-Z]+[0-9]+):([A-Z]+[0-9]+)\b"
    for prefix, start, end in re.findall(range_pattern, formula):
        refs.add((prefix + "." if prefix else "") + start + ":" + end)
    formula = re.sub(range_pattern, " ", formula)

    # 1) Références avec label : <<Label>>.xxx
    for r in re.findall(r"<<[^>]+>>\.[A-Za-z0-9_\.]+", formula):
        refs.add(r)

    # 2) Propriétés d'objet : Pad.Length, Sketch.Constraints[33], Pad.Placement.Base.x
    for r in re.findall(r"[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z0-9_\[\]]+)+", formula):
        refs.add(r)

    # 3) Cellules simples : A12, AA14 (pas celles précédées d'un point : datas.A12 est lu en 1 ou 2)
    for r in re.findall(r"(?<![.\w])[A-Z]+[0-9]+\b", formula):
        refs.add(r)

    # 5) 🔥 Détection des alias (Longueur, Largeur, etc.)
    tokens = re.findall(r"[A-Za-z_][A-Za-z0-9_]*", formula)

    sheet_aliases = alias_map.get(sheet_name, {})

    for t in tokens:
        if t in sheet_aliases:
            refs.add(sheet_aliases[t])

    return refs


def constraint_index(node):
    """
    Index de la contrainte d'esquisse d'un nœud propriété, ou None.
    Accepte 'Constraints[3]' et les contraintes nommées 'Constraints.largeur'.
    """
    prop = node.get("property") or ""
    if node.get("kind") != "property" or not prop.startswith("Constraints"):
        return None
    match = re.fullmatch(r"Constraints\[(\d+)\]", prop)
    if match:
        return int(match.group(1))
    if prop.startswith("Constraints."):
        name = prop[len("Constraints."):]
        sketch = App.ActiveDocument.getObject(node.get("object") or "")
        for i, constraint in enumerate(getattr(sketch, "Constraints", None) or []):
            if constraint.Name == name:
                return i
    return None


def openSketchInEditMode(sketch):
    """
    Ouvre un sketch en mode édition.
    Retourne :
        True  → ouverture OK
        False → aucune vue 3D ouverte ou ouverture impossible
    """

    if sketch is None:
        return False

    # Une vue 3D est nécessaire pour le mode édition : en ouvrir une s'il n'y en a pas
    # (cas où seul le tableur est ouvert)
    views3d = Gui.ActiveDocument.mdiViewsOfType("Gui::View3DInventor")
    if not views3d:
        try:
            Gui.runCommand("Std_ViewCreate", 0)
        except Exception:  # volontaire : commande absente ou impossible
            pass
        views3d = Gui.ActiveDocument.mdiViewsOfType("Gui::View3DInventor")
    if not views3d:
        return False

    # Tenter d'ouvrir le sketch
    try:
        Gui.ActiveDocument.setEdit(sketch)
        return True
    except Exception:
        return False


def create_or_update_node(
    graph,
    ref,
    kind=None,
    obj_name=None,
    prop_name=None,
    sheet_name=None,
    cell_name=None,
    fc_parent=None,
    fc_parent_label=None,
):
    if ref not in graph:
        graph[ref] = {
            "ref": ref,
            "kind": kind,
            "object": obj_name,
            "property": prop_name,
            "sheet": sheet_name,
            "cell": cell_name,
            "value": None,
            "formula": None,
            "alias": None,
            "label": None,
            "constraint_type": None,
            "errors": set(),
            "parents": set(),
            "children": set(),
            "fc_parent": fc_parent,
            "fc_parent_label": fc_parent_label,

        }
    else:
        #  Mise à jour du kind si on découvre plus tard que c’est une cellule
        if kind is not None and graph[ref]["kind"] != kind:
            graph[ref]["kind"] = kind

        #  Mise à jour des infos de cellule
        if sheet_name is not None:
            graph[ref]["sheet"] = sheet_name
        if cell_name is not None:
            graph[ref]["cell"] = cell_name

        #  Mise à jour des infos d'objet FreeCAD
        if obj_name is not None:
            graph[ref]["object"] = obj_name
        if prop_name is not None:
            graph[ref]["property"] = prop_name
        if fc_parent is not None:
            graph[ref]["fc_parent"] = fc_parent

        if fc_parent_label is not None:
            graph[ref]["fc_parent_label"] = fc_parent_label


def construire_label_to_name():
    d = {}

    doc = App.ActiveDocument
    if not doc:
        return d

    # Feuilles
    for obj in doc.Objects:
        if obj.TypeId == "App::Spreadsheet":
            d[obj.Label] = obj.Name

    # Objets FreeCAD
    for obj in doc.Objects:
        d[obj.Label] = obj.Name

    return d


def traiter_feuille(sheet, graph, label_to_name, alias_map):
    xml = sheet.cells.Content
    if not xml:
        return

    root = ET.fromstring(xml)

    for cell in root.findall("Cell"):
        addr = cell.get("address")      # ex: "D4"
        content = cell.get("content")   # ex: "=Longueur + 2"
        alias = cell.get("alias")       # ex: "Largeur"

        if not content:
            continue

        # Nom canonique : datas.D4
        cell_ref = f"{sheet.Name}.{addr}"

        create_or_update_node(
            graph,
            ref=cell_ref,
            kind="cell",
            sheet_name=sheet.Name,
            cell_name=addr,
        )

        # --- MÉTADONNÉES ---
        graph[cell_ref]["formula"] = content

        if graph[cell_ref]["alias"] is None:
            graph[cell_ref]["alias"] = alias

        if graph[cell_ref]["label"] is None or graph[cell_ref]["label"] == graph[cell_ref]["cell"]:
            graph[cell_ref]["label"] = alias if alias else addr

        try:
            graph[cell_ref]["value"] = sheet.get(addr)
        except Exception as e:  # volontaire : cellule illisible = en erreur
            graph[cell_ref]["errors"].add(str(e))

        if content.startswith("#"):
            graph[cell_ref]["errors"].add(content)
        elif content.startswith("="):
            # FreeCAD met "ERR: message" comme valeur d'une cellule en erreur
            message = error_message(graph[cell_ref]["value"])
            if message:
                graph[cell_ref]["errors"].add(message)

        # --- DÉPENDANCES ---
        if content.startswith("="):
            raw_refs = extract_raw_refs_for_graph(content, sheet.Name, alias_map)

            for raw in raw_refs:
                for norm in normalize_refs(raw, sheet.Name, label_to_name, alias_map):
                    create_or_update_node(graph, norm)

                    graph[cell_ref]["parents"].add(norm)
                    graph[norm]["children"].add(cell_ref)


# ===============================================================================
# Property selected in the property view (ex : Placement > Position > x of a Pad)
# selectedPropertyInPropertyView() and getPropertyValue() are shared with
# Sketch_Constraint_From_Spreadsheet.FCMacro (https://github.com/2cv001/FreeCAD-macros) :
# keep them identical in both macros.
#
# How it works (the property view has no Python API) :
# - the rows of the property view are read with Qt (tree named "propertyEditorData")
# - top rows are groups (Base, Attachment...), their children are the properties,
#   and below come the sub-items (Position, x...)
# - the internal name of the property is read in its tooltip ("Name: Placement"),
#   because the displayed name is translated ("Axe de rotation" in French)
# - sub-items have no tooltip : their displayed label is compared with the English
#   label translated by FreeCAD, so it works whatever the FreeCAD language
# - the path found is checked on the object before being returned
# ===============================================================================
SelectedProperty = namedtuple(
    "SelectedProperty", "obj path name typeId value editable hasSubItems"
)
# obj         : object owning the property (Pad, Sketch...)
# path        : path for obj.setExpression(), same format as obj.ExpressionEngine
#               without the leading '.' (ex 'Placement.Rotation.Axis.x')
# name        : internal name of the property (ex 'Placement')
# typeId      : type of the property (ex 'App::PropertyPlacement')
# value       : current value, read on the object with the path
# editable    : the value is editable and not greyed in the property view
# hasSubItems : the selected row has sub-items (ex Placement, Position) : link one of them

# Sub-items whose internal path differs from the label shown by FreeCAD.
# key : property type without 'App::Property' ; value : {English label : internal path}
# Sub-items not listed (x, y, z, named constraints...) use their displayed label.
PROPERTY_SUB_ITEMS = {
    "Placement": {"Position": "Base", "Axis": "Rotation.Axis", "Angle": "Rotation.Angle"},
    "Rotation": {"Axis": "Axis", "Angle": "Angle"},
}


def getPropertyValue(obj, path):
    # path : as in obj.ExpressionEngine, ex 'Length', '.Placement.Base.x',
    #        'Constraints[3]' or 'Constraints.myName' (a sketch constraint object is returned)
    # raise an exception (AttributeError, IndexError...) if the path does not exist
    value = obj
    for part in path.lstrip(".").split("."):
        match = re.fullmatch(r"(\w+)\[(\d+)\]", part)
        if match:  # ex Constraints[3]
            value = getattr(value, match.group(1))[int(match.group(2))]
        elif isinstance(value, (list, tuple)):  # ex Constraints.myName
            value = next(v for v in value if getattr(v, "Name", None) == part)
        else:
            value = getattr(value, part)
    return value


def selectedPropertyInPropertyView(obj=None):
    # obj : object owning the property (default : the single object selected in the tree)
    # return a SelectedProperty, or None if no property of obj is selected

    def translated(label):  # label as displayed by FreeCAD in the current language
        return QtGui.QApplication.translate("App::Property", label)

    def displayedName(name):  # 'MapMode' -> 'Map Mode', as FreeCAD displays it
        return translated(re.sub(r"(?<=[a-z0-9])(?=[A-Z])", " ", name))

    def pathExists(path):
        try:
            getPropertyValue(obj, path)
            return True
        except Exception:  # on purpose : AttributeError, IndexError, StopIteration...
            return False

    if obj is None:
        selection = Gui.Selection.getSelection()
        if len(selection) != 1:
            return None
        obj = selection[0]

    tree = Gui.getMainWindow().findChild(QtGui.QTreeView, "propertyEditorData")
    if tree is None:
        return None
    selected = [i for i in tree.selectedIndexes() if i.column() == 0]
    index = selected[0] if selected else tree.currentIndex().siblingAtColumn(0)

    rows = []  # from the top (group) down to the clicked row
    while index.isValid():
        rows.insert(0, index)
        index = index.parent()
    if len(rows) < 2:  # nothing or a group is selected
        return None
    propertyRow, subRows, clicked = rows[1], rows[2:], rows[-1]

    # internal name of the property : in the tooltip ("Type: ...\nName: Placement\n...")
    match = re.search(r"^Name: (\S+)$", propertyRow.data(QtCore.Qt.ToolTipRole) or "", re.M)
    name = match.group(1) if match else None
    if name not in obj.PropertiesList:  # no name in the tooltip (older FreeCAD) : compare displayed names
        shown = propertyRow.data(QtCore.Qt.DisplayRole) or ""
        name = next((p for p in obj.PropertiesList
                     if shown in (p, displayedName(p)) or shown.replace(" ", "") == p), None)
    if name is None:
        return None
    typeId = obj.getTypeIdOfProperty(name)

    # sub-items : English label translated by FreeCAD, else the displayed label
    path = name
    subLabels = PROPERTY_SUB_ITEMS.get(typeId.split("::Property")[-1], {})
    for level, row in enumerate(subRows):
        shown = row.data(QtCore.Qt.DisplayRole) or ""
        candidates = [internal for label, internal in subLabels.items()
                      if level == 0 and shown in (label, translated(label))]
        candidates += [shown, shown.replace(" ", "")]
        found = next((c for c in candidates if pathExists(path + "." + c)), None)
        if found is None:
            print("Property path not found :", obj.Name + "." + path + " > " + shown)
            return None
        path += "." + found

    if not pathExists(path):
        return None
    flags = clicked.siblingAtColumn(1).flags()
    return SelectedProperty(
        obj=obj,
        path=path,
        name=name,
        typeId=typeId,
        value=getPropertyValue(obj, path),
        editable=bool(flags & QtCore.Qt.ItemIsEditable) and bool(flags & QtCore.Qt.ItemIsEnabled),
        hasSubItems=tree.model().rowCount(clicked) > 0,
    )


def select_property_row(path, attempts=10):
    # Sélectionne (en bleu, comme un clic) et montre la ligne de la propriété path
    # (chemin interne, ex 'Length' ou 'AttachmentOffset.Base.z') dans la fenêtre des
    # propriétés, en dépliant les niveaux nécessaires.
    # - lignes du haut = groupes, leurs enfants = propriétés, reconnues par leur
    #   infobulle ("Type: App::PropertyPlacement\nName: AttachmentOffset")
    # - sous-éléments : le chemin interne est converti en libellé affiché, à l'inverse de
    #   selectedPropertyInPropertyView() (Base -> "Position", traduit par FreeCAD)
    # La fenêtre des propriétés se remplit un peu après la sélection de l'objet :
    # si la ligne n'est pas encore là, nouvel essai 100 ms plus tard (attempts fois).
    # Propre à cette macro (non partagée).
    def translated(label):
        return QtGui.QApplication.translate("App::Property", label)

    tree = Gui.getMainWindow().findChild(QtGui.QTreeView, "propertyEditorData")
    if tree is None:
        return
    model = tree.model()
    parts = path.split(".")

    # 1) la propriété
    found, typeId = None, ""
    for g in range(model.rowCount()):
        group = model.index(g, 0)
        for p in range(model.rowCount(group)):
            index = model.index(p, 0, group)
            tip = index.data(QtCore.Qt.ToolTipRole) or ""
            if re.search(r"^Name: " + re.escape(parts[0]) + r"$", tip, re.M):
                found = index
                match = re.search(r"^Type: (\S+)$", tip, re.M)
                typeId = match.group(1) if match else ""
                break
        if found is not None:
            break

    if found is None:
        if attempts > 1:
            QtCore.QTimer.singleShot(100, lambda: select_property_row(path, attempts - 1))
        else:
            print("Propriété non trouvée dans la fenêtre des propriétés :", path)
        return

    # 2) les sous-éléments (ex : Base.z -> "Position" puis "z")
    remaining = parts[1:]
    subLabels = PROPERTY_SUB_ITEMS.get(typeId.split("::Property")[-1], {})
    level = 0
    while remaining:
        labels, used = None, 1
        if level == 0:
            # 1er niveau sous la propriété : libellés connus (ex Rotation.Axis -> "Axis")
            for label, internal in subLabels.items():
                internal_parts = internal.split(".")
                if remaining[:len(internal_parts)] == internal_parts:
                    labels, used = {label, translated(label)}, len(internal_parts)
                    break
        if labels is None:
            labels = {remaining[0], translated(remaining[0])}
        child = next((model.index(r, 0, found) for r in range(model.rowCount(found))
                      if (model.index(r, 0, found).data(QtCore.Qt.DisplayRole) or "") in labels), None)
        if child is None:  # niveau non trouvé : on s'arrête au dernier trouvé
            print("Sous-élément non trouvé dans la fenêtre des propriétés :", path)
            break
        tree.expand(found)
        found, remaining, level = child, remaining[used:], level + 1

    tree.setCurrentIndex(found)
    tree.selectionModel().select(
        found, QtCore.QItemSelectionModel.ClearAndSelect | QtCore.QItemSelectionModel.Rows)
    tree.scrollTo(found)

    # La sélection n'est affichée en bleu que si sa fenêtre est active et a le focus.
    # Ici, la fenêtre active est l'Inspector : activer la fenêtre qui contient la fenêtre
    # des propriétés (la fenêtre principale de FreeCAD, ou la sienne si elle est détachée),
    # puis lui donner le focus une fois l'activation faite.
    def focus_property_view():
        window = tree.window()
        window.activateWindow()
        tree.setFocus(QtCore.Qt.OtherFocusReason)

    focus_property_view()
    QtCore.QTimer.singleShot(100, focus_property_view)


def traiter_objet(obj, graph, label_to_name, alias_map):

    if not hasattr(obj, "ExpressionEngine"):
        return

    for prop, expr in obj.ExpressionEngine:
        if prop.startswith("."):
            prop = prop[1:]

        ref_obj = obj.Name + "." + prop

        # --- 1) Trouver le parent FreeCAD réel ---
        parent = None

        # Parent PartDesign (Pad, Pocket, Sketch…)
        if hasattr(obj, "getParentGeoFeatureGroup"):
            parent = obj.getParentGeoFeatureGroup()

        # Fallback : InList (Groupes, Part, etc.)
        if not parent and hasattr(obj, "InList") and obj.InList:
            parent = obj.InList[0]

        fc_parent = parent.Name if parent else None
        fc_parent_label = parent.Label if parent else None

        # --- 2) Créer ou mettre à jour le nœud ---
        create_or_update_node(
            graph,
            ref=ref_obj,
            kind="property",
            obj_name=obj.Name,
            prop_name=prop,
            fc_parent=fc_parent,
            fc_parent_label=fc_parent_label,
        )

        # --- 3) Infos de base ---
        graph[ref_obj]["formula"] = expr
        graph[ref_obj]["label"] = obj.Label

        # --- 4) Valeur et type de contrainte ---
        try:
            value = getPropertyValue(obj, prop)
        except Exception:  # volontaire : propriété supprimée, renommée, contrainte absente...
            value = None
        ctype = None
        # contrainte d'esquisse (Constraints[3] ou Constraints.nom) : sa valeur et son type
        if prop.startswith("Constraints") and hasattr(value, "Type") and hasattr(value, "Value"):
            ctype = value.Type
            value = value.Value

        graph[ref_obj]["value"] = value
        graph[ref_obj]["constraint_type"] = ctype

        # --- 4b) Expression en erreur : FreeCAD ne l'applique pas, la propriété
        #         garde son ancienne valeur ---
        if hasattr(obj, "evalExpression"):
            expected = None
            try:
                expected = obj.evalExpression(expr)
                message = error_message(expected)
            except Exception as e:  # volontaire : référence inconnue, syntaxe...
                message = str(e)
            # valeur refusée (solveur, valeur interdite...) : la propriété ne vaut
            # pas ce que donne l'expression
            # (sauf l'axe d'une rotation : FreeCAD le ramène à une longueur de 1,
            #  ex x = 10 devient 0.99995, et la fenêtre des propriétés affiche 10)
            if not message and "Rotation.Axis" not in prop and not same_number(expected, value):
                message = tr("value_not_applied").format(expected=expected, value=value)
            if message:
                graph[ref_obj]["errors"].add(message)

        # --- 5) DÉPENDANCES ---
        parents_bruts = extract_raw_refs_for_graph(expr, None, alias_map)

        for p in parents_bruts:
            sheet_guess = guess_sheet_from_ref(p, alias_map, label_to_name)
            for p_norm in normalize_refs(p, sheet_guess, label_to_name, alias_map):
                create_or_update_node(graph, p_norm)
                graph[ref_obj]["parents"].add(p_norm)
                graph[p_norm]["children"].add(ref_obj)

                # --- 6) RÉCURSIVITÉ ---
                if "." in p_norm:  # ex: Pad.Length, Sketch.Constraints[3], Body.Placement.Base.x
                    obj2_name, prop2 = p_norm.split(".", 1)
                    obj2 = App.ActiveDocument.getObject(obj2_name)

                    if obj2:
                        # Récursivité sur l'objet
                        traiter_objet(obj2, graph, label_to_name, alias_map)

                        # Récursivité sur la propriété référencée
                        if hasattr(obj2, "ExpressionEngine"):
                            for propX, exprX in obj2.ExpressionEngine:
                                if propX == prop2:
                                    ref_prop = obj2_name + "." + prop2
                                    create_or_update_node(graph, ref_prop)

                                    graph[ref_prop]["formula"] = exprX
                                    graph[ref_prop]["label"] = obj2.Label
                                    graph[ref_prop]["value"] = None
                                    graph[ref_prop]["constraint_type"] = None

                                    parents2 = extract_raw_refs_for_graph(exprX, obj2_name, alias_map)
                                    for p2 in parents2:
                                        sheet_guess2 = guess_sheet_from_ref(p2, alias_map, label_to_name)
                                        for p2_norm in normalize_refs(p2, sheet_guess2,
                                                                      label_to_name, alias_map):
                                            create_or_update_node(graph, p2_norm)
                                            graph[ref_prop]["parents"].add(p2_norm)
                                            graph[p2_norm]["children"].add(ref_prop)


def error_message(value):
    # 'ERR: msg' (valeur d'une cellule en erreur, répétée quand l'erreur vient
    # d'une autre cellule) -> 'msg' ; None si value n'est pas une erreur
    if not isinstance(value, str) or not value.startswith("ERR:"):
        return None
    return next((m.strip() for m in value.split("ERR:") if m.strip()), value)


def same_number(expected, value):
    # True si les deux valeurs sont égales, ou si on ne sait pas les comparer
    # (Placement, texte...). Quantity : valeur en unités de base (mm, °) ;
    # les angles des contraintes et des rotations sont en radians : accepter les deux.
    def number(v):
        if isinstance(v, bool):
            return None
        if isinstance(v, (int, float)):
            return float(v)
        if hasattr(v, "Value") and isinstance(v.Value, (int, float)):
            return float(v.Value)
        return None

    a, b = number(expected), number(value)
    if a is None or b is None:
        return True
    # tolérance : le solveur et les calculs en flottants donnent 9.9999999 au lieu de 10
    return any(math.isclose(x, b, rel_tol=1e-5, abs_tol=1e-4) for x in (a, math.radians(a)))


def mark_errors(graph):
    # Erreurs propagées : une cellule ou propriété est en erreur si elle a sa
    # propre erreur, ou si elle utilise une cellule / propriété en erreur.
    # node["error_origins"] : les refs d'où vient l'erreur ([ref] si elle en est l'origine)
    def origins(ref, visiting):
        node = graph[ref]
        if "error_origins" in node:
            return node["error_origins"]
        if ref in visiting:  # boucle de références
            return set()
        visiting.add(ref)
        found = set()
        for parent in node["parents"]:
            if parent in graph:
                found |= origins(parent, visiting)
        visiting.discard(ref)
        if node["errors"] and not found and node.get("upstream_errors"):
            found = set(node["upstream_errors"])  # erreur venant d'un objet en amont
        elif node["errors"] and not found:
            found = {ref}  # la ref est l'origine de l'erreur
        elif node["errors"] or (found and node["kind"] == "cell"):
            pass  # erreur héritée
        elif found:
            # propriété sans erreur propre utilisant une ref en erreur : FreeCAD n'a
            # pas vu d'erreur, elle garde une valeur qui n'est peut-être plus à jour
            found = set()
        node["error_origins"] = found
        return found

    for ref in graph:
        origins(ref, set())


def build_graph():
    graph = {}

    doc = App.ActiveDocument
    if not doc:
        return graph

    # 0) Construire alias_map pour toutes les feuilles
    alias_map = build_alias_map_for_all_sheets()

    # 1) Construire label_to_name
    label_to_name = construire_label_to_name()

    # 2) Parcourir tous les objets FreeCAD
    for obj in doc.Objects:
        traiter_objet(obj, graph, label_to_name, alias_map)

    # 3) Parcourir toutes les feuilles
    for obj in doc.Objects:
        if obj.TypeId == "Spreadsheet::Sheet":
            traiter_feuille(obj, graph, label_to_name, alias_map)

    # 4) Objets en erreur (sketch non résolu, pad impossible...)
    for obj in doc.Objects:
        if "Invalid" not in getattr(obj, "State", ()) or not hasattr(obj, "ExpressionEngine"):
            continue
        refs = [obj.Name + "." + prop.lstrip(".") for prop, _ in obj.ExpressionEngine]
        refs = [r for r in refs if r in graph]
        try:
            status = " ".join(obj.getStatusString().split())
        except Exception:  # volontaire : message seulement
            status = "Invalid"

        # 4a) Sketch : le solveur donne les contraintes en cause (numéros à partir de 1)
        found = False
        for attr, kind in (("ConflictingConstraints", "conflict"),
                           ("RedundantConstraints", "redundant"),
                           ("MalformedConstraints", "malformed")):
            for number in getattr(obj, attr, None) or ():
                for r in refs:
                    if constraint_index(graph[r]) == number - 1:
                        graph[r]["errors"].add(
                            tr("constraint_conflict").format(kind=kind, status=status))
                        found = True

        # 4b) Sinon, si aucune de ses propriétés n'est repérée, elles sont toutes suspectes
        if not found and not any(graph[r]["errors"] for r in refs):
            for r in refs:
                graph[r]["errors"].add(tr("object_invalid_state").format(status=status))

    # 4b') Objet en erreur sans expression (ex : Pad invalide) : une ligne pour l'objet
    #      lui-même, pour qu'il soit visible avec la case Erreurs
    for obj in doc.Objects:
        if "Invalid" not in getattr(obj, "State", ()) or obj.TypeId == "Spreadsheet::Sheet":
            continue
        if any(n["object"] == obj.Name and n["kind"] == "property" for n in graph.values()):
            continue
        try:
            status = " ".join(obj.getStatusString().split())
        except Exception:  # volontaire : message seulement
            status = "Invalid"
        create_or_update_node(graph, obj.Name, kind="object", obj_name=obj.Name)
        graph[obj.Name]["label"] = obj.Label
        graph[obj.Name]["errors"].add(tr("object_invalid_state").format(status=status))

    # 4c) Objet en aval d'un objet en erreur (ex : Pad d'un Sketch non résolu) : son
    #     erreur vient de cet objet, pas de ses propres propriétés
    error_objects = {n["object"] for n in graph.values() if n["errors"] and n["kind"] == "property"}
    error_objects |= {o.Name for o in doc.Objects if "Invalid" in getattr(o, "State", ())
                      and o.TypeId != "Spreadsheet::Sheet"}
    for node in graph.values():
        if node["errors"] and node["kind"] in ("property", "object"):
            obj = doc.getObject(node["object"])
            upstream = getattr(obj, "OutListRecursive", ()) if obj else ()
            node["upstream_errors"] = sorted(
                o.Name for o in upstream
                if o.Name in error_objects and o.TypeId != "Spreadsheet::Sheet")

    # 5) Erreurs : origine et propagation
    mark_errors(graph)

    return graph


def normalize_ref(ref, current_sheet_name, label_to_name, alias_map):
    if not ref:
        return None

    ref = ref.strip()
    if not ref:
        return None

    # 1) Gestion des <<label>>.xxx
    if ref.startswith("<<"):
        end = ref.find(">>")
        if end != -1:
            label = ref[2:end]
            suffix = ref[end+2:]
            if suffix.startswith("."):
                suffix = suffix[1:]

            # label → nom interne FreeCAD
            name = label_to_name.get(label, label)

            # On continue la normalisation
            ref = name + "." + suffix if suffix else name

    # 2) Références avec point : datas.Longueur, Pad.Length, etc.
    if "." in ref:
        sheet, key = ref.split(".", 1)

        # Label écrit sans << >> (ex : datas.Longueur pour le tableur nommé Spreadsheet) :
        # comme FreeCAD, le nom interne est prioritaire, sinon on cherche le label
        if sheet not in alias_map and sheet in label_to_name \
                and App.ActiveDocument.getObject(sheet) is None:
            sheet = label_to_name[sheet]
            ref = sheet + "." + key

        # 🔥 Vérifier si key est un alias
        if sheet in alias_map:
            if key in alias_map[sheet]:
                return alias_map[sheet][key]   # ex: datas.D3

        return ref

    # 3) Alias locaux (Longueur → datas.D3)
    if current_sheet_name in alias_map:
        sheet_aliases = alias_map[current_sheet_name]
        if ref in sheet_aliases:
            return sheet_aliases[ref]

    # 4) Référence locale de type D12 → datas.D12
    if current_sheet_name is not None:
        has_letter = any(c.isalpha() for c in ref)
        has_digit = any(c.isdigit() for c in ref)
        if has_letter and has_digit:
            return current_sheet_name + "." + ref

    # 5) Sinon, on renvoie tel quel
    return ref


def normalize_refs(ref, current_sheet_name, label_to_name, alias_map):
    """
    normalize_ref(), et une plage (datas.A1:B3) donne ses cellules non vides.
    Retourne une liste de références (vide si ref est vide).
    """
    norm = normalize_ref(ref, current_sheet_name, label_to_name, alias_map)
    if not norm:
        return []
    match = re.fullmatch(r"([^.]+)\.([A-Z]+[0-9]+):([A-Z]+[0-9]+)", norm)
    if not match:
        return [norm]
    sheet_name, start, end = match.groups()
    sheet = App.ActiveDocument.getObject(sheet_name)
    xml = getattr(getattr(sheet, "cells", None), "Content", None)
    if not xml:
        return []
    (row1, col1), (row2, col2) = addr_to_row_col(start), addr_to_row_col(end)
    rows = range(min(row1, row2), max(row1, row2) + 1)
    cols = range(min(col1, col2), max(col1, col2) + 1)
    cells = []
    for cell in ET.fromstring(xml).findall("Cell"):  # cellules non vides du tableur
        addr = cell.get("address")
        if addr and cell.get("content"):
            row, col = addr_to_row_col(addr)
            if row in rows and col in cols:
                cells.append(sheet_name + "." + addr)
    return cells


def guess_sheet_from_ref(ref, alias_map, label_to_name):
    # Cas <<Label>>.xxx
    if ref.startswith("<<"):
        end = ref.find(">>")
        if end != -1:
            label = ref[2:end]  # ex: datas
            return label_to_name.get(label, label)

    # Cas datas.Longueur
    if "." in ref:
        return ref.split(".")[0]

    # Cas Longueur → chercher dans toutes les feuilles
    for sheet, aliases in alias_map.items():
        if ref in aliases:
            return sheet

    return None


def explore_graph(ref, graph, allow_parents=True, allow_children=True, visited=None):
    """
    Explore récursivement le graphe à partir de ref.
    Retourne un ensemble de nœuds atteignables selon les directions autorisées.
    """
    if isinstance(ref, tuple):
        ref = ref[0]
    if visited is None:
        visited = set()

    if ref in visited:
        return visited

    visited.add(ref)

    # Parents
    if allow_parents:
        for p in graph[ref]["parents"]:
            explore_graph(p, graph, allow_parents, allow_children, visited)

    # Children
    if allow_children:
        for c in graph[ref]["children"]:
            explore_graph(c, graph, allow_parents, allow_children, visited)

    return visited


def objects_in_scope(names):
    """
    Objets désignés par names (noms internes), avec le contenu des conteneurs
    (Body, Part, groupes : propriété Group), dans l'ordre du document.
    names vide = tout le document.
    """
    doc = App.ActiveDocument
    if not names:
        return list(doc.Objects)
    found = {}

    def add(obj):
        if obj is None or obj.Name in found:
            return
        found[obj.Name] = obj
        for child in getattr(obj, "Group", None) or []:
            add(child)

    for name in names:
        add(doc.getObject(name))
    return [o for o in doc.Objects if o.Name in found]


def object_root_refs(graph, objects):
    """
    Racines de l'arbre quand on part d'objets : leurs propriétés (et cellules pour un
    tableur) qui ont une expression, sont utilisées ou sont en erreur.
    Retourne [(objet, [refs triées])], sans les objets qui n'en ont aucune.
    Une cellule sans lien (valeur simple) n'est pas retenue.
    """
    by_object = {}
    for ref, node in graph.items():
        if node["parents"] or node["children"] or node["errors"]:
            by_object.setdefault(ref.partition(".")[0], []).append(ref)
    return [(o, sorted(by_object[o.Name])) for o in objects if o.Name in by_object]


def ask_keep_invalid_change(title, message, allow_keep=True):
    box = QtGui.QMessageBox(FreeCADGui.getMainWindow())
    box.setIcon(QtGui.QMessageBox.Warning)
    box.setWindowTitle(title)
    box.setText(message)

    # Toujours ajouter Annuler
    btn_cancel = box.addButton(tr("btn_cancel"), QtGui.QMessageBox.RejectRole)

    # Ajouter "Accepter quand même" seulement si allow_keep=True
    if allow_keep:
        btn_accept = box.addButton(tr("btn_accept_anyway"), QtGui.QMessageBox.AcceptRole)
    else:
        btn_accept = None

    box.exec()

    # Si le bouton existe et a été cliqué
    if allow_keep and box.clickedButton() == btn_accept:
        return True

    return False


class RefDialog2(QtGui.QDialog):
    def __init__(self, sheet, root_property=None, root_objects=None):
        # root_property : ex 'Pad.Length' to start the tree from this property
        #                 instead of the cells selected in the spreadsheet
        # root_objects  : ex ('Body',) to start the tree from these objects (and the
        #                 content of the containers) ; () = the whole document
        super(RefDialog2, self).__init__(FreeCADGui.getMainWindow())

        self.last_level = 0
        self.sheet = sheet
        self.root_property = root_property
        self.root_objects = root_objects
        self.graph = build_graph()

        # Flags internes
        self._editing = False
        self._building = False
        self._old_value = None
        self._old_column = None

        # --- Flags Qt ---
        self.setWindowFlags(
            QtCore.Qt.Dialog |
            QtCore.Qt.WindowTitleHint |
            QtCore.Qt.WindowCloseButtonHint |
            QtCore.Qt.WindowMinMaxButtonsHint
        )
        self.setWindowTitle(f"{tr('title')} – {self.title_target()}")
        self.setMinimumWidth(400)

        layout = QtGui.QVBoxLayout()
        layout.setSpacing(0)
        layout.setContentsMargins(10, 0, 10, 10)

        # ============================================================
        #  LIGNES VUES : OUT/IN + filtres
        # ============================================================
        top_line = QtGui.QHBoxLayout()


        modes_box = QtGui.QVBoxLayout()
        modes_box.setSpacing(0)
        modes_box.setContentsMargins(0, 0, 0, 0)

        group_lines = QtGui.QGroupBox(tr("lines_shown"))
        group_lines.setLayout(modes_box)
        group_lines.setContentsMargins(0, 0, 0, 0)

        self.cb_out = QtGui.QCheckBox(tr("mode_out"))
        self.cb_out.setChecked(True)
        self.cb_out.setStyleSheet("QCheckBox { padding: 0px; margin: 0px; }")

        self.cb_in = QtGui.QCheckBox(tr("mode_in"))
        self.cb_in.setChecked(True)
        self.cb_in.setStyleSheet("QCheckBox { padding: 0px; margin: 0px; }")

        modes_box.addWidget(self.cb_out)
        modes_box.addWidget(self.cb_in)

        self.filter_cells = QtGui.QCheckBox(tr("filter_cells"))
        self.filter_cells.setChecked(True)
        self.filter_cells.setStyleSheet("QCheckBox { padding: 0px; margin: 0px; }")

        self.filter_constraints = QtGui.QCheckBox(tr("filter_constraints"))
        self.filter_constraints.setChecked(True)
        self.filter_constraints.setStyleSheet("QCheckBox { padding: 0px; margin: 0px; }")
        self.filter_constraints.setToolTip(tr("hint_constraint"))

        self.filter_others = QtGui.QCheckBox(tr("filter_others"))
        self.filter_others.setChecked(True)
        self.filter_others.setStyleSheet("QCheckBox { padding: 0px; margin: 0px; }")

        modes_box.addWidget(self.filter_cells)
        modes_box.addWidget(self.filter_constraints)
        modes_box.addWidget(self.filter_others)

        self.filter_errors = QtGui.QCheckBox(tr("filter_errors"))
        self.filter_errors.setChecked(True)
        self.filter_errors.setStyleSheet("QCheckBox { padding: 0px; margin: 0px; }")
        self.filter_errors.setToolTip(tr("hint_errors"))
        modes_box.addWidget(self.filter_errors)

        self.filter_cells.toggled.connect(self.on_change_coche)
        self.filter_constraints.toggled.connect(self.on_change_coche)
        self.filter_others.toggled.connect(self.on_change_coche)
        self.filter_errors.toggled.connect(self.on_change_coche)

        top_line.addWidget(group_lines)
        top_line.addSpacing(5)

        # ============================================================
        #  Colonne du milieu : options d'affichage
        # ============================================================
        self.show_formula = QtGui.QCheckBox(tr("show_formula"))
        self.show_value = QtGui.QCheckBox(tr("show_value"))
        self.show_labels_alias = QtGui.QCheckBox(tr("show_labels_alias"))
        self.show_constraint_types = QtGui.QCheckBox(tr("show_constraint_types"))
        self.show_constraint_types.setToolTip(tr("hint_constraint"))

        group_middle = QtGui.QGroupBox(tr("middle_group"))
        middle_box = QtGui.QVBoxLayout()
        middle_box.setSpacing(0)
        middle_box.setContentsMargins(0, 0, 5, 0)
        group_middle.setLayout(middle_box)

        middle_box.addWidget(self.show_labels_alias)
        middle_box.addWidget(self.show_formula)
        middle_box.addWidget(self.show_value)
        middle_box.addWidget(self.show_constraint_types)

        help_label = QtGui.QLabel(tr("hint_open_sketch"))
        help_label.setWordWrap(True)
        help_label.setStyleSheet("color: gray; font-style: italic;")
        middle_box.addWidget(help_label)

        self.show_labels_alias.stateChanged.connect(self.recompute)
        self.show_constraint_types.stateChanged.connect(self.recompute)

        # ============================================================
        #  Colonne de droite (boutons)
        # ============================================================
        right_box = QtGui.QVBoxLayout()
        right_box.setAlignment(QtCore.Qt.AlignTop)
        right_box.setSpacing(10)

        self.btn_refresh = QtGui.QPushButton()
        self.btn_refresh.setMaximumWidth(32)
        icon = QtGui.QApplication.style().standardIcon(QtGui.QStyle.SP_BrowserReload)
        self.btn_refresh.setIcon(icon)
        self.btn_refresh.setToolTip(tr("btn_refresh_tt"))
        right_box.addWidget(self.btn_refresh)

        self.btn_expand_all = QtGui.QPushButton(tr("btn_expand"))
        self.btn_expand_all.setMaximumWidth(120)
        right_box.addWidget(self.btn_expand_all)

        self.level_spin = QtGui.QSpinBox()
        self.level_spin.setMinimum(1)
        self.level_spin.setMaximum(10)
        self.level_spin.setValue(INITIAL_LEVEL)
        self.level_spin.setPrefix(tr("level_prefix"))
        self.level_spin.setMaximumWidth(120)
        right_box.addWidget(self.level_spin)

        self.btn_collapse_all = QtGui.QPushButton(tr("btn_collapse"))
        self.btn_collapse_all.setMaximumWidth(120)
        right_box.addWidget(self.btn_collapse_all)

        top_line.addWidget(group_middle)
        top_line.addSpacing(5)
        top_line.addLayout(right_box)

        layout.addLayout(top_line)

        # ============================================================
        #  Arbre
        # ============================================================
        self.tree = QtGui.QTreeWidget()

        # ============================================================
        #  DÉLÉGUÉ LECTURE SEULE POUR LES COLONNES NON ÉDITABLES
        # ============================================================
        class ReadOnlyDelegate(QtGui.QStyledItemDelegate):
            def createEditor(self, parent, option, index):
                return None  # empêche l'édition

        readonly = ReadOnlyDelegate(self.tree)

        # Colonnes non éditables : 0, 2, 4
        for col in (0, 2, 4):
            self.tree.setItemDelegateForColumn(col, readonly)

        self.tree.itemDoubleClicked.connect(self.on_item_double_click_constraint)
        # le double clic ouvre ce que désigne la ligne : il ne doit pas aussi plier / déplier
        # la branche (les flèches ▶ ▼ et le bouton "tout déplier" restent disponibles)
        self.tree.setExpandsOnDoubleClick(False)

        self.tree.setHeaderHidden(False)
        self.tree.setColumnCount(5)
        self.tree.setHeaderLabels([
            tr("col_name"),
            tr("col_label"),
            tr("col_value"),
            tr("col_content"),
            tr("col_type")
        ])

        self.tree.header().setStretchLastSection(True)

        self.tree.header().setSectionsMovable(True)
        self.tree.header().setSectionsClickable(True)
        self.tree.header().setSectionResizeMode(QtGui.QHeaderView.Interactive)
        self.tree.header().setMinimumSectionSize(30)
        self.tree.header().setStretchLastSection(True)

        self.tree.setStyleSheet("QTreeWidget::item:hover { background-color: #e0e0e0; }")
        self.tree.setSelectionBehavior(QtGui.QAbstractItemView.SelectRows)

        layout.addWidget(self.tree)
        self.setLayout(layout)

        # ============================================================
        #  Connexions
        # ============================================================
        self.btn_refresh.clicked.connect(self.on_refresh)

        # Sélections vues au dernier lancement : le bouton Relancer repart
        # de celle qui a changé depuis (propriété, cellules ou objets)
        self._seen_property = current_selected_property()
        self._seen_cells = current_selected_cells()
        self._seen_objects = current_selected_objects()

        # Où l'utilisateur a cliqué en dernier hors de cette fenêtre ("property",
        # "objects" ou "cells"), relevé toutes les 300 ms : un simple relevé, qui n'intervient pas
        # dans les clics (un suivi par le signal focusChanged cassait le double clic)
        self._last_source = None
        self._focus_timer = QtCore.QTimer(self)
        self._focus_timer.timeout.connect(self.poll_focus)
        self._focus_timer.start(300)
        self.btn_expand_all.clicked.connect(self.expand_all)
        self.btn_collapse_all.clicked.connect(self.collapse_all)
        self.level_spin.valueChanged.connect(self.set_expand_level)

        self.cb_out.toggled.connect(self.on_change_coche)
        self.cb_in.toggled.connect(self.on_change_coche)

        self.show_formula.stateChanged.connect(self.recompute)
        self.show_value.stateChanged.connect(self.recompute)

        # --- Début et fin d’édition ---
        # self.tree.itemDoubleClicked.connect(self.on_start_edit)
        self.tree.itemClicked.connect(self.on_item_simple_clicked)

        self.tree.itemChanged.connect(self.on_item_changed)
        self.tree.setEditTriggers(QtGui.QAbstractItemView.EditKeyPressed |
                                  QtGui.QAbstractItemView.SelectedClicked)

        # ============================================================
        #  Charger les réglages
        # ============================================================
        self.load_settings()

        # Premier affichage
        self.recompute()

    def wait_for_recompute(self):
        from PySide import QtCore
        import FreeCAD as App

        while True:
            busy = False

            # On surveille UNIQUEMENT les objets en Recompute
            for obj in App.ActiveDocument.Objects:
                if hasattr(obj, "State") and "Recompute" in obj.State:
                    busy = True
                    break

            if not busy:
                break

            QtCore.QThread.msleep(10)
            App.processEvents()

    # --------------------------------------------------------
    # Colonnes : construction des 5 champs
    # --------------------------------------------------------
    def enrich_columns(self, ref, node):
        """
        Construit les 5 colonnes :
        0: Nom interne (datas.D3, Pad.Length, ...)
        1: Label / alias
        2: résultat
        3: Contenu (formule)
        4: Type de contrainte
        """
        kind = node.get("kind")

        nom = ref
        alias = ""
        valeur = ""
        contenu = ""
        ctype = ""

        # Cellule de spreadsheet
        if kind == "cell":
            sheet = node.get("sheet")
            cell = node.get("cell")
            nom = f"{sheet}.{cell}" if sheet and cell else ref
            alias = node.get("label") or node.get("alias") or (cell or "")
            v = node.get("value")
            if v is not None:
                valeur = str(v)
            f = node.get("formula")
            if f:
                contenu = str(f)
            ct = node.get("constraint_type")
            if ct:
                ctype = str(ct)

        # Propriété d'objet FreeCAD
        elif kind == "property":
            obj = node.get("object")
            prop = node.get("property")
            nom = f"{obj}.{prop}" if obj and prop else ref
            alias = node.get("label") or ""
            v = node.get("value")
            if v is not None:
                valeur = str(v)
            f = node.get("formula")
            if f:
                contenu = str(f)
            ct = node.get("constraint_type")
            if ct:
                ctype = str(ct)

        # Autre
        else:
            nom = ref
            alias = node.get("label") or ""
            v = node.get("value")
            if v is not None:
                valeur = str(v)
            f = node.get("formula")
            if f:
                contenu = str(f)
            ct = node.get("constraint_type")
            if ct:
                ctype = str(ct)

        return [nom, alias, valeur, contenu, ctype]

    # --------------------------------------------------------
    # Sauvegarde / chargement INI
    # --------------------------------------------------------
    def load_settings(self):
        if not os.path.exists(INI_PATH):
            return

        config = configparser.ConfigParser()
        config.read(INI_PATH, encoding="utf-8")
        ui = config["UI"]

        # --- Cases à cocher OUT / IN ---
        self.cb_out.setChecked(ui.getboolean("show_out", True))
        self.cb_in.setChecked(ui.getboolean("show_in", True))

        # --- Filtres Cellules / Contraintes / Autres ---
        self.filter_cells.setChecked(ui.getboolean("filter_cells", True))
        self.filter_constraints.setChecked(ui.getboolean("filter_constraints", True))
        self.filter_others.setChecked(ui.getboolean("filter_others", True))
        self.filter_errors.setChecked(ui.getboolean("filter_errors", True))

        # --- Cases à cocher existantes ---
        self.show_formula.setChecked(ui.getboolean("show_formula", False))
        self.show_value.setChecked(ui.getboolean("show_value", False))
        self.show_labels_alias.setChecked(ui.getboolean("show_labels_alias", False))
        self.show_constraint_types.setChecked(ui.getboolean("show_constraint_types", False))
        # --- Taille ---
        w = ui.getint("width", 600)
        h = ui.getint("height", 400)
        self.resize(w, h)

        # --- Restaurer l'état des colonnes ---
        header = self.tree.header()

        # 1) Restaurer l'état du header (ordre, visibilité, tri)
        if "header_state" in ui:
            try:
                state = QtCore.QByteArray.fromBase64(ui["header_state"].encode("utf-8"))
                header.restoreState(state)
            except:
                pass

        # 2) Forcer le mode interactif (sinon restoreState remet ResizeToContents)
        header.setSectionResizeMode(QtGui.QHeaderView.Interactive)
        header.setMinimumSectionSize(30)

        # 3) Restaurer les largeurs de colonnes
        if "column_widths" in ui:
            widths = ui["column_widths"].split(",")
            for i, cw in enumerate(widths):
                try:
                    self.tree.setColumnWidth(i, int(cw))
                except:
                    pass

        if "column_widths" in ui:
            widths = ui["column_widths"].split(",")
            for i, cw in enumerate(widths):
                try:
                    self.tree.setColumnWidth(i, int(cw))
                except:
                    pass

        # --- Position ---
        x = ui.getint("pos_x", 100)
        y = ui.getint("pos_y", 100)

        saved_screen = ui.get("screen_name", None)
        screens = QtGui.QApplication.screens()
        target_screen = None

        if saved_screen:
            for s in screens:
                if s.name() == saved_screen:
                    target_screen = s
                    break

        if not target_screen:
            target_screen = QtGui.QApplication.primaryScreen()

        geo = target_screen.availableGeometry()
        rect = QtCore.QRect(x, y, w, h)

        if not geo.contains(rect.center()):
            cx = geo.center().x() - w // 2
            cy = geo.center().y() - h // 2
            x, y = cx, cy

        self.move(x, y)

    def save_settings(self):
        config = configparser.ConfigParser()
        config["UI"] = {}

        # --- Cases à cocher OUT / IN ---
        config["UI"]["show_out"] = str(self.cb_out.isChecked())
        config["UI"]["show_in"] = str(self.cb_in.isChecked())

        # --- Filtres Cellules / Contraintes / Autres ---
        config["UI"]["filter_cells"] = str(self.filter_cells.isChecked())
        config["UI"]["filter_constraints"] = str(self.filter_constraints.isChecked())
        config["UI"]["filter_others"] = str(self.filter_others.isChecked())
        config["UI"]["filter_errors"] = str(self.filter_errors.isChecked())

        # --- Cases à cocher existantes ---
        config["UI"]["show_formula"] = str(self.show_formula.isChecked())
        config["UI"]["show_value"] = str(self.show_value.isChecked())
        config["UI"]["show_labels_alias"] = str(self.show_labels_alias.isChecked())
        config["UI"]["show_constraint_types"] = str(self.show_constraint_types.isChecked())
        # --- Taille ---
        size = self.size()
        config["UI"]["width"] = str(size.width())
        config["UI"]["height"] = str(size.height())

        # --- Position ---
        pos = self.pos()
        config["UI"]["pos_x"] = str(pos.x())
        config["UI"]["pos_y"] = str(pos.y())


        # --- Ordre et état des colonnes ---
        header_state = self.tree.header().saveState()
        config["UI"]["header_state"] = header_state.toBase64().data().decode("utf-8")

        # Sauvegarde des largeurs de colonnes
        widths = [self.tree.columnWidth(i) for i in range(self.tree.columnCount())]
        config["UI"]["column_widths"] = ",".join(str(w) for w in widths)

        # --- Écran ---
        try:
            screen = self.screen()
            if screen:
                config["UI"]["screen_name"] = screen.name()
        except:
            pass

        # --- Écriture du fichier ---
        with open(INI_PATH, "w", encoding="utf-8") as f:
            config.write(f)

    def closeEvent(self, event):
        self._focus_timer.stop()
        self.save_settings()
        super().closeEvent(event)

    # --------------------------------------------------------
    # Mise à jour visibilité des colonnes
    # --------------------------------------------------------
    def update_column_visibility(self):
        # 0: Nom (toujours visible)
        self.tree.setColumnHidden(1, not self.show_labels_alias.isChecked())      # Label/Alias
        self.tree.setColumnHidden(2, not self.show_value.isChecked())            # Valeur
        self.tree.setColumnHidden(3, not self.show_formula.isChecked())          # Contenu
        self.tree.setColumnHidden(4, not self.show_constraint_types.isChecked()) # Type

    # --------------------------------------------------------
    # Bouton Relancer : repartir de la sélection qui a changé depuis le
    # dernier lancement (propriété dans la fenêtre des propriétés, ou cellules)
    # --------------------------------------------------------
    def poll_focus(self):
        focus = QtGui.QApplication.focusWidget()
        if focus is None or focus is self or self.isAncestorOf(focus):
            return
        tree = Gui.getMainWindow().findChild(QtGui.QTreeView, "propertyEditorData")
        if tree is not None and (focus is tree or tree.isAncestorOf(focus)):
            self._last_source = "property"
        elif object_view_has_focus():  # arbre FreeCAD ou vue 3D
            self._last_source = "objects"
        elif current_selected_cells() is not None:  # fenêtre active = un tableur
            self._last_source = "cells"

    def on_refresh(self):
        current = {
            "property": current_selected_property(),
            "cells": current_selected_cells(),
            "objects": current_selected_objects(),
        }
        seen = {
            "property": self._seen_property,
            "cells": self._seen_cells,
            "objects": self._seen_objects,
        }
        # dernier clic connu : il l'emporte sur les changements de sélection ;
        # sinon la sélection qui a changé (si plusieurs : tableur, puis propriété, puis objets)
        source = None
        if self._last_source is not None and current[self._last_source] is not None:
            source = self._last_source
        else:
            source = next((s for s in ("cells", "property", "objects")
                           if current[s] is not None and current[s] != seen[s]), None)
        if source == "property":
            self.root_property, self.root_objects = current["property"], None
        elif source == "objects":
            self.root_property, self.root_objects = None, current["objects"]
        elif source == "cells":
            self.root_property, self.root_objects = None, None
        self._seen_property = current["property"]
        self._seen_cells = current["cells"]
        self._seen_objects = current["objects"]
        self.recompute()

    # --------------------------------------------------------
    # RECOMPUTE
    def recompute(self):

        self._building = True

        try:
            # ------------------------------------------------------------
            # 0) Forcer Qt à flusher les signaux
            # ------------------------------------------------------------
            self.tree.clearFocus()
            self.tree.setFocus()

            # Niveau affiché avant reconstruction (y compris les branches dépliées
            # à la main), pour le garder ; au premier affichage : celui du compteur
            if self.tree.topLevelItemCount():
                level = self.displayed_level()
            else:
                level = self.level_spin.value()

            # ------------------------------------------------------------
            # 1) à 4) Point de départ : la propriété ou les objets choisis,
            #         sinon les cellules sélectionnées dans la feuille
            #         roots : [(ligne titre de l'objet ou None, [refs])]
            # ------------------------------------------------------------
            if self.root_property is not None:
                roots = [(None, self.property_roots())]
            elif self.root_objects is not None:
                roots = self.object_roots()
            else:
                roots = [(None, self.cell_roots())]

            if not any(refs for _, refs in roots):
                self.update_column_visibility()
                return

            # ------------------------------------------------------------
            # 5) Construire l’arbre (sous la ligne de son objet s'il y en a une ;
            #    ligne retirée si les filtres masquent tout son contenu)
            # ------------------------------------------------------------
            for header, refs in roots:
                for root in refs:
                    self.build_tree(root, header)
                if header is not None and header.childCount() == 0:
                    self.tree.takeTopLevelItem(self.tree.indexOfTopLevelItem(header))

            # ------------------------------------------------------------
            # 6) et 7) Même niveau qu'avant, ou le plus profond qui existe encore
            # ------------------------------------------------------------
            depth = self.get_tree_depth()
            level = max(1, min(level, depth))
            self.level_spin.blockSignals(True)
            self.level_spin.setMaximum(depth)
            self.level_spin.setValue(level)
            self.level_spin.blockSignals(False)
            self.set_expand_level(level)

            # ------------------------------------------------------------
            # 8) Mise à jour de la visibilité des colonnes
            # ------------------------------------------------------------
            self.update_column_visibility()

        finally:
            self._building = False

    # --------------------------------------------------------
    # Texte du titre : la feuille, ou la propriété de départ
    # --------------------------------------------------------
    def title_target(self):
        doc = App.ActiveDocument
        if self.root_property is not None:
            obj_name, _, path = self.root_property.partition(".")
            obj = doc.getObject(obj_name)
            return (obj.Label if obj else obj_name) + "." + path
        if self.root_objects is not None:
            if not self.root_objects:
                return doc.Label
            objs = [doc.getObject(n) for n in self.root_objects]
            return ", ".join(o.Label for o in objs if o is not None)
        return self.sheet.Label if self.sheet is not None else ""

    # --------------------------------------------------------
    # Point de départ = les objets sélectionnés (ou tout le document) : leurs
    # propriétés et cellules qui ont une expression, sont utilisées ou en erreur,
    # sous une ligne par objet quand il y en a plusieurs
    # --------------------------------------------------------
    def object_roots(self):
        self.graph = build_graph()
        self.setWindowTitle(f"{tr('title')} – {self.title_target()}")
        self.tree.clear()
        groups = object_root_refs(self.graph, objects_in_scope(self.root_objects))
        if len(groups) == 1:
            return [(None, groups[0][1])]
        roots = []
        for obj, refs in groups:
            header = QtGui.QTreeWidgetItem(self.tree, [obj.Label, "", "", "", ""])
            font = header.font(0)
            font.setBold(True)
            header.setFont(0, font)
            header.setToolTip(0, f"Name : {obj.Name}\nLabel : {obj.Label}")
            roots.append((header, refs))
        return roots

    # --------------------------------------------------------
    # Point de départ = la propriété choisie au lancement
    # --------------------------------------------------------
    def property_roots(self):
        self.graph = build_graph()  # la propriété ou ses liens ont pu changer
        self.setWindowTitle(f"{tr('title')} – {self.title_target()}")
        self.tree.clear()
        return [self.root_property] if self.root_property in self.graph else []

    # --------------------------------------------------------
    # Point de départ = les cellules sélectionnées dans la feuille
    # --------------------------------------------------------
    def cell_roots(self):
        # 1) Détecter la feuille active
        current_view = Gui.ActiveDocument.ActiveView

        # Si on est dans la vue 3D → ouvrir la feuille
        if type(current_view).__name__ == "View3DInventorPy" and self.sheet is not None:
            self.sheet.ViewObject.doubleClicked()

            # IMPORTANT : relire la vue active
            current_view = Gui.ActiveDocument.ActiveView

        # Essayer de récupérer la feuille via la vue
        new_sheet = None
        if hasattr(current_view, "getSheet"):
            try:
                new_sheet = current_view.getSheet()
            except Exception:  # volontaire : la feuille est cherchée ensuite dans la sélection
                pass

        # Fallback : récupérer via la sélection
        if not new_sheet:
            sel = Gui.Selection.getSelection()
            if sel and sel[0].TypeId == "Spreadsheet::Sheet":
                new_sheet = sel[0]

        # Si la feuille a changé → reconstruire le graphe
        if new_sheet and new_sheet != self.sheet:
            self.sheet = new_sheet
            self.graph = build_graph()

        if self.sheet is None:  # lancé depuis une propriété, sans tableur ouvert
            self.tree.clear()
            return []

        # 2) Mise à jour du titre
        self.setWindowTitle(f"{tr('title')} – {self.sheet.Label}")

        # 3) Nettoyage de l'arbre
        self.tree.clear()

        # 4) Lire la sélection sur la feuille
        selected = self.sheet.ViewObject.getView().selectedCells()
        if not selected:
            return []

        # Convertir la sélection en adresses
        addrs = []
        for item in selected:
            if isinstance(item, str):
                addrs.append(item)
            elif len(item) == 2:
                addrs.append(cell_to_addr(item[0], item[1]))

        return [
            f"{self.sheet.Name}.{a}"
            for a in addrs
            if f"{self.sheet.Name}.{a}" in self.graph
        ]

    # --- Fonctions de catégorisation ---
    def should_display(self, ref, root_ref, reachable, branch_direction):
        # Ligne affichée si elle correspond aux cases cochées, ou si elle mène (dans la
        # direction de sa branche : parents = Uses, children = Used by) à une ligne affichée
        if reachable is None:
            reachable = self.graph.keys()
        return (self.matches_filters(self.graph[ref])
                or self.has_descendant_matching(ref, branch_direction, reachable))

    def matches_filters(self, node):
        # La ligne correspond aux cases cochées : sa catégorie (Cellules, Contraintes,
        # Autres), ou Erreurs si elle est en erreur (Erreurs ne masque jamais rien)
        cat = self.get_node_category(node)
        if cat == "cell" and self.filter_cells.isChecked():
            return True
        if cat == "constraint" and self.filter_constraints.isChecked():
            return True
        if cat == "other" and self.filter_others.isChecked():
            return True
        return bool(self.filter_errors.isChecked() and node.get("error_origins"))

    def get_node_category(self, node):
        """
        Retourne la catégorie logique d’un nœud du graphe :
        - "constraint"  → si c’est une contrainte d’esquisse
        - "cell"        → si c’est une cellule de spreadsheet
        - "other"       → tout le reste (propriétés d’objets FreeCAD, etc.)
        """

        # 1) Contrainte d’esquisse
        if node.get("constraint_type"):
            return "constraint"

        # 2) Cellule de spreadsheet
        if node.get("kind") == "cell":
            return "cell"

        # 3) Tout le reste
        return "other"

    def has_descendant_matching(self, ref, direction, reachable=None, visited=None):
        """
        Une ligne atteignable depuis ref, en suivant STRICTEMENT la direction donnée
        ("parents" = Uses, "children" = Used by), correspond aux cases cochées.
        """
        if reachable is None:
            reachable = self.graph.keys()
        if visited is None:
            visited = set()
        if ref in visited:
            return False
        visited.add(ref)

        for next_ref in self.graph[ref][direction]:
            if next_ref not in reachable:
                continue
            if self.matches_filters(self.graph[next_ref]):
                return True
            if self.has_descendant_matching(next_ref, direction, reachable, visited):
                return True
        return False

    # --------------------------------------------------------
    # BUILD TREE
    # --------------------------------------------------------

    def add_recursive_common(self, parent_item, ref, reachable, root_ref,
                             relation_key, recursive_func):

        for child_ref in sorted(self.graph[ref][relation_key]):
            if child_ref not in reachable:
                continue

            if not self.should_display(child_ref, root_ref, reachable, relation_key):
                continue

            node = self.graph[child_ref]
            cols = self.enrich_columns(child_ref, node)

            item = QtGui.QTreeWidgetItem(parent_item, cols)
            item.setData(0, QtCore.Qt.UserRole, child_ref)
            self.style_error(item, child_ref)

            # Rendre l’item éditable (les colonnes interdites sont bloquées par le délégué)
            item.setFlags(item.flags() | QtCore.Qt.ItemIsEditable)

            # --- Nouveau tooltip centralisé ---
            tooltip = self.build_tooltip(child_ref)
            for col in range(self.tree.columnCount()):
                item.setToolTip(col, tooltip)

            # --- Récursion ---
            recursive_func(item, child_ref, reachable, root_ref)

    def add_in_recursive(self, parent_item, ref, reachable, root_ref):
        self.add_recursive_common(
            parent_item, ref, reachable, root_ref,
            relation_key="parents",
            recursive_func=self.add_in_recursive
        )

    def add_out_recursive(self, parent_item, ref, reachable, root_ref):
        self.add_recursive_common(
            parent_item, ref, reachable, root_ref,
            relation_key="children",
            recursive_func=self.add_out_recursive
        )

    # --------------------------------------------------------
    # Ligne en rouge si en erreur, en gras si elle est l'origine de l'erreur
    # --------------------------------------------------------
    def style_error(self, item, ref):
        origins = self.graph[ref].get("error_origins")
        if not origins:
            return
        brush = QtGui.QBrush(QtGui.QColor(220, 40, 40))
        for col in range(self.tree.columnCount()):
            item.setForeground(col, brush)
            if ref in origins:
                font = item.font(col)
                font.setBold(True)
                item.setFont(col, font)

    def build_tooltip(self, ref):
        node = self.graph[ref]
        lines = []

        # --- Parent FreeCAD ---
        if node.get("fc_parent"):
            parent = node["fc_parent"]
            parent_label = node.get("fc_parent_label") or parent
            lines.append(f"Parent : {parent_label} ({parent})")

        # --- Spreadsheet + Cell (pour les cellules) ---
        if node.get("sheet"):
            lines.append(f"Spreadsheet : {node['sheet']}")
        if node.get("cell"):
            lines.append(f"Cell : {node['cell']}")

        # --- Name (uniquement pour objets FreeCAD) ---
        if node.get("object"):
            lines.append(f"Name : {node['object']}")

        # --- Label (uniquement pour objets FreeCAD) ---
        if node.get("kind") != "cell" and node.get("label"):
            lines.append(f"Label : {node['label']}")

        # --- Alias (pour les cellules) ---
        if node.get("alias"):
            lines.append(f"Alias : {node['alias']}")

        # --- Property (pour objets FreeCAD) ---
        if node.get("property"):
            lines.append(f"Property : {node['property']}")

        # --- Expression (toujours avant Value) ---
        if node.get("formula"):
            lines.append(f"Expression : {node['formula']}")

        # --- Value ---
        if node.get("value") is not None:
            lines.append(f"Value : {node['value']}")

        # --- Constraint type ---
        if node.get("constraint_type"):
            lines.append(f"Constraint : {node['constraint_type']}")

        # --- Errors ---
        if node.get("errors"):
            for err in node["errors"]:
                lines.append(f"Error : {err}")
        origins = node.get("error_origins") or set()
        if origins and origins != {ref}:
            lines.append(tr("error_inherited").format(refs=", ".join(sorted(origins))))

        return "\n".join(lines)

    def build_tree(self, root, parent_item=None):
        # parent_item : ligne de l'objet sous laquelle placer la racine (None = en haut)

        # ------------------------------------------------------------
        # Protection : on indique qu'on construit l'arbre
        # ------------------------------------------------------------
        self._building = True

        try:
            # ------------------------------------------------------------
            # 1) Exploration du graphe (AVANT filtrage)
            # ------------------------------------------------------------
            allow_parents = self.cb_out.isChecked()
            allow_children = self.cb_in.isChecked()

            reachable = explore_graph(root, self.graph, allow_parents, allow_children)

            # ------------------------------------------------------------
            # 2) Filtrage de la racine (APRÈS exploration)
            # ------------------------------------------------------------
            root_visible = False

            # 2a) Si la racine correspond directement à un filtre → visible
            root_visible = self.matches_filters(self.graph[root])

            # 2b) Sinon : tester les branches Uses et Used by
            if not root_visible and self.cb_out.isChecked():
                for p in self.graph[root]["parents"]:
                    if p in reachable and self.should_display(p, root, reachable, "parents"):
                        root_visible = True
                        break

            if not root_visible and self.cb_in.isChecked():
                for c in self.graph[root]["children"]:
                    if c in reachable and self.should_display(c, root, reachable, "children"):
                        root_visible = True
                        break

            if not root_visible:
                return

            # ------------------------------------------------------------
            # 3) Création de l’item racine
            # ------------------------------------------------------------
            cols_root = self.enrich_columns(root, self.graph[root])
            root_item = QtGui.QTreeWidgetItem(
                self.tree if parent_item is None else parent_item, cols_root)
            root_item.setData(0, QtCore.Qt.UserRole, root)
            self.style_error(root_item, root)

            # --- Rendre éditables les colonnes 1 et 3 ---
            # Rendre éditables uniquement les colonnes 1 (Alias) et 3 (Formule)
            # --- Rendre l’item racine éditable (filtrage par colonne se fait ailleurs) ---
            root_item.setFlags(root_item.flags() | QtCore.Qt.ItemIsEditable)

            #root_item.setFlags(flags)

            # Tooltip enrichi
            tooltip = self.build_tooltip(root)
            for col in range(self.tree.columnCount()):
                root_item.setToolTip(col, tooltip)

            root_item.setExpanded(True)

            # ------------------------------------------------------------
            # 4) Section IN (Uses)
            # ------------------------------------------------------------
            if self.cb_out.isChecked():
                in_item = QtGui.QTreeWidgetItem(root_item, [tr("uses"), "", "", "", ""])
                self.add_in_recursive(in_item, root, reachable, root)

                if in_item.childCount() == 0:
                    root_item.removeChild(in_item)

            # ------------------------------------------------------------
            # 5) Section OUT (Used by)
            # ------------------------------------------------------------
            if self.cb_in.isChecked():
                out_item = QtGui.QTreeWidgetItem(root_item, [tr("used_by"), "", "", "", ""])
                self.add_out_recursive(out_item, root, reachable, root)

                if out_item.childCount() == 0:
                    root_item.removeChild(out_item)

        finally:
            # ------------------------------------------------------------
            # Fin de construction : on réactive les signaux
            # ------------------------------------------------------------
            self._building = False

    def get_tree_depth(self):
        """Retourne la profondeur maximale de l'arbre affiché."""

        def depth_of(item):
            if item.childCount() == 0:
                return 1
            return 1 + max(depth_of(item.child(i)) for i in range(item.childCount()))

        max_depth = 1
        for i in range(self.tree.topLevelItemCount()):
            d = depth_of(self.tree.topLevelItem(i))
            if d > max_depth:
                max_depth = d

        # Niveau qui déplie tout l'arbre (voir set_expand_level) : le niveau N montre
        # N+1 lignes de profondeur, sauf le niveau 1 qui ne montre que les racines.
        # Ex : ligne d'objet -> lignes en erreur (2 lignes de profondeur) : niveau 2
        return max_depth - 1 if max_depth >= 3 else max_depth

    def displayed_level(self):
        # Niveau (au sens du compteur, voir set_expand_level) correspondant à la ligne
        # dépliée visible la plus profonde
        deepest = -1

        def rec(item, depth):
            nonlocal deepest
            if not item.isExpanded():
                return
            deepest = max(deepest, depth)
            for i in range(item.childCount()):
                rec(item.child(i), depth + 1)

        for i in range(self.tree.topLevelItemCount()):
            rec(self.tree.topLevelItem(i), 0)
        return max(1, deepest + 1)

    def set_expand_level(self, level):
        # Applique un niveau d'expansion à l'arbre.

        self.last_level = level

        def rec(item, depth):
            # Déplier si on est dans la profondeur autorisée
            if level == 1 or level == 0:
                item.setExpanded(depth < level - 1)
            else:
                item.setExpanded(depth < level)

            # Parcours des enfants
            for i in range(item.childCount()):
                rec(item.child(i), depth + 1)

        # Appliquer à chaque racine
        for i in range(self.tree.topLevelItemCount()):
            rec(self.tree.topLevelItem(i), 0)

    # --------------------------------------------------------
    # EXPAND / COLLAPSE
    # --------------------------------------------------------
    def expand_all(self):
        def rec(item, depth):
            item.setExpanded(True)
            max_depth = depth
            for i in range(item.childCount()):
                d = rec(item.child(i), depth + 1)
                if d > max_depth:
                    max_depth = d
            return max_depth

        # Calculer la profondeur max sur toutes les racines
        max_depth = 0
        for i in range(self.tree.topLevelItemCount()):
            d = rec(self.tree.topLevelItem(i), 1)  # profondeur racine = 1
            if d > max_depth:
                max_depth = d

        # Mettre à jour le spinbox sans déclencher le callback
        self.level_spin.blockSignals(True)
        self.level_spin.setValue(self.get_tree_depth())
        self.level_spin.blockSignals(False)

    def collapse_all(self):
        # Replier selon le niveau par défaut
        self.set_expand_level(DEFAULT_COLLAPSE_LEVEL)

        # Synchroniser le SpinBox
        self.level_spin.setValue(DEFAULT_COLLAPSE_LEVEL)

    # --------------------------------------------------------
    # Double clic dans l'arbre : le résultat dépend de la colonne
    # - colonne Expression : sélectionne les termes de l'expression (=D5+D3 : D5 et D3,
    #   sum(A1:A4) : les cellules non vides de la plage, Pad.Length : la propriété...)
    # - autres colonnes : ouvre ce que désigne la ligne (cellule dans son tableur,
    #   propriété dans l'arbre FreeCAD, contrainte dans son sketch)
    # --------------------------------------------------------
    EXPRESSION_COLUMN = 3

    def on_item_double_click_constraint(self, item, column):
        ref = item.data(0, QtCore.Qt.UserRole)
        if not ref:  # lignes de section "Utilise" / "Utilisé par"
            return
        if column == self.EXPRESSION_COLUMN:
            # les termes de l'expression = ce que la ligne utilise
            self.open_refs(sorted(self.graph.get(ref, {}).get("parents", ())))
        else:
            self.open_refs([ref])

    # --------------------------------------------------------
    # Ouvre / sélectionne des références du graphe (ex : 'Spreadsheet.D3', 'Pad.Length',
    # 'Sketch.Constraints[2]') : cellules dans leur tableur, contrainte dans son sketch,
    # sinon propriétés dans l'arbre FreeCAD
    # --------------------------------------------------------
    def open_refs(self, refs):
        doc = App.ActiveDocument
        cells, constraints, properties = [], [], []
        for ref in refs:
            obj_name, _, path = ref.partition(".")
            obj = doc.getObject(obj_name)
            if obj is None:
                continue
            if not path:  # ligne d'un objet (objet en erreur sans expression)
                properties.append((obj, None))
                continue
            if obj.TypeId == "Spreadsheet::Sheet":
                cells.append(ref)
                continue
            idx = constraint_index({"kind": "property", "object": obj_name, "property": path})
            if idx is not None:
                constraints.append((obj_name, idx))
            else:
                properties.append((obj, path))

        if cells:
            self.select_cells(cells)
        if constraints:
            self.open_constraint(*constraints[0])
        elif properties:
            self.select_properties(properties)

    # --------------------------------------------------------
    # Ouvre le sketch en mode édition, contrainte sélectionnée
    # --------------------------------------------------------
    def open_constraint(self, sketch_name, constraint_index):
        doc = App.ActiveDocument
        sketch = doc.getObject(sketch_name)

        # Vérifier si un objet est déjà en édition
        vp = Gui.ActiveDocument.getInEdit()

        # Si aucun sketch n'est en édition → tenter ouverture auto SI vue 3D existe
        if vp is None or vp.Object.Name != sketch_name:

            # Tentative d'ouverture automatique du sketch
            opened = openSketchInEditMode(sketch)

            if opened:
                # Le sketch a été ouvert automatiquement → on continue
                vp = Gui.ActiveDocument.getInEdit()
            else:
                # Aucune vue 3D → on NE demande rien de plus
                QtGui.QMessageBox.warning(
                    None,
                    tr("sketch_not_open_title"),
                    tr("sketch_not_open_msg") + sketch_name
                )
                return

        # Trouver le conteneur (Body ou rien)
        body = sketch.getParentGeoFeatureGroup() if hasattr(sketch, "getParentGeoFeatureGroup") else None
        container_name = body.Name if body else sketch_name

        # Sélectionner la contrainte (+1)
        Gui.Selection.clearSelection()
        Gui.Selection.addSelection(
            doc.Name,
            container_name,
            f"{sketch_name}.Constraint{constraint_index + 1}"
        )

        # Mettre la vue 3D (sketch en édition) au premier plan, pour que l'utilisateur la voie
        self.show3DView(doc)

    # ---------------------------------------------------------
    # Sélectionne des propriétés (liste de (objet, chemin)) : les objets dans l'arbre
    # FreeCAD, et s'il n'y en a qu'un, la propriété dans la fenêtre des propriétés,
    # prête à être modifiée
    # ---------------------------------------------------------
    def select_properties(self, properties):
        doc = App.ActiveDocument
        Gui.Selection.clearSelection()
        for obj, _ in properties:
            Gui.Selection.addSelection(doc.Name, obj.Name)
        if len({obj.Name for obj, _ in properties}) == 1 and properties[0][1]:
            path = properties[0][1]  # ex 'AttachmentOffset.Base.z' : jusqu'à la ligne z
            # la fenêtre des propriétés se met à jour un peu après la sélection
            QtCore.QTimer.singleShot(300, lambda: select_property_row(path))

    # ---------------------------------------------------------
    # Sélectionne des cellules (ex : ['Spreadsheet.A3', 'Spreadsheet.D5']) dans la
    # fenêtre de leur tableur, ouverte si besoin
    # ---------------------------------------------------------
    def select_cells(self, cell_refs):
        def selection_flag(name):  # PySide6 : enum sans conversion directe en int
            flag = getattr(QtCore.QItemSelectionModel, name)
            try:
                return int(flag)
            except TypeError:
                return flag.value

        by_sheet = {}
        for ref in cell_refs:
            sheet_name, _, addr = ref.partition(".")
            by_sheet.setdefault(sheet_name, []).append(addr)

        for sheet_name, addrs in by_sheet.items():
            sheet = App.ActiveDocument.getObject(sheet_name)
            if sheet is None:
                continue
            try:
                sheet.ViewObject.doubleClicked()  # ouvre la fenêtre du tableur, ou la met devant
                view = sheet.ViewObject.getView()
                # cellule courante d'abord : setCurrentIndex peut remplacer la sélection
                view.setCurrentIndex(addrs[0])
                view.select(addrs[0], selection_flag("ClearAndSelect"))
                for addr in addrs[1:]:
                    view.select(addr, selection_flag("Select"))
            except Exception as e:  # volontaire : la sélection des cellules n'est qu'une aide
                print("Cellules non sélectionnées :", sheet_name, addrs, e)

    # ---------------------------------------------------------
    # Vérifie si un sketch est en mode édition
    # ---------------------------------------------------------
    def isSketchInEdit(self, sketch):
        vp = Gui.ActiveDocument.getInEdit()
        return vp is not None and hasattr(vp, "Object") and vp.Object == sketch

    # ---------------------------------------------------------
    # Met au premier plan la vue 3D du document (celle du sketch en édition)
    # ---------------------------------------------------------
    def show3DView(self, doc):
        mdiArea = Gui.getMainWindow().findChild(QtGui.QMdiArea)
        if mdiArea is None:
            return
        views3d = [w for w in mdiArea.subWindowList()
                   if w.widget() is not None
                   and w.widget().metaObject().className() == "Gui::View3DInventor"]
        # de préférence une vue 3D de ce document (son nom figure dans le titre de la fenêtre)
        ofThisDoc = [w for w in views3d if doc.Label in w.windowTitle()]
        windows = ofThisDoc or views3d
        if windows:
            mdiArea.setActiveSubWindow(windows[0])

    def on_change_coche(self, checked):
        self.recompute()
        if checked:  # seulement si COCHÉ
            self.expand_all()

    def on_item_simple_clicked(self, item, column):
        """
        Début d'édition utilisateur.
        On mémorise l’ancienne valeur pour détecter un vrai changement.
        """
        if column not in (1, 3):  # colonnes non éditables
            return

        self._old_value = item.text(column)
        self._old_column = column

    def handle_property_formula(self, node, item, column, new_value, old_value):
        warning_shown = False
        keep_invalid = False

        raw_name = item.text(0)
        obj_name = raw_name.split(".")[0]
        obj = App.ActiveDocument.getObject(obj_name)
        prop = node.get("property")
        expr = new_value.lstrip("=")

        try:
            # --- 1) Test expression ---
            try:
                obj.setExpression(prop, expr)
            except Exception as e:
                print("Erreur d’expression :", e)

                QtGui.QMessageBox.warning(
                    None,
                    tr("object_invalid_title"),
                    tr("object_invalid_expression_msg")
                )

                # --- Rollback dans l'arbre (comme avant) ---
                self._editing = True
                item.setText(column, old_value)
                self._editing = False
                return

            # --- 2) Test géométrie ---
            try:
                App.ActiveDocument.recompute()
            except Exception as e:
                print("Erreur géométrique :", e)

                keep_invalid = ask_keep_invalid_change(
                    tr("object_invalid_title"),
                    tr("object_invalid_msg"),
                    allow_keep=False
                )

                if not keep_invalid:
                    # --- Rollback expression ---
                    old_expr = old_value.lstrip("=")
                    obj.setExpression(prop, old_expr)
                    App.ActiveDocument.recompute()

                    # --- Rollback arbre ---
                    self._editing = True
                    item.setText(column, old_value)
                    self._editing = False
                    return

                # Sinon : accepter quand même
                self.recompute()
                return

            # --- 3) Test état Invalid ---
            if hasattr(obj, "State") and "Invalid" in obj.State:
                warning_shown = True
                keep_invalid = ask_keep_invalid_change(
                    tr("object_invalid_title"),
                    tr("object_invalid_msg"),
                    allow_keep=False
                )

                if not keep_invalid:
                    raise ValueError("Object became invalid")

                self.recompute()
                return

            # --- OK ---
            self.recompute()
            keep_invalid = True

        except Exception as e:
            print("Formula PROPERTY ERROR:", e)

            if not warning_shown:
                keep_invalid = ask_keep_invalid_change(
                    tr("object_invalid_title"),
                    tr("object_invalid_msg"),
                    allow_keep=False
                )
                if keep_invalid:
                    self.recompute()
                    return

            if not keep_invalid:
                old_expr = old_value.lstrip("=")
                try:
                    obj.setExpression(prop, old_expr)
                    App.ActiveDocument.recompute()
                except Exception as e2:
                    print("ERROR restoring old expression:", e2)

                # --- Rollback arbre ---
                self._editing = True
                item.setText(column, old_value)
                self._editing = False

    def handle_object_label(self, node, new_value, old_value, item):
        try:
            raw_name = node.get("object")
            obj_name_only = raw_name.split(".")[0]
            obj = App.ActiveDocument.getObject(obj_name_only)

            if obj is None:
                raise ValueError(f"Object not found: {obj_name_only}")

            # --- Appliquer le nouveau label ---
            obj.Label = new_value
            node["label"] = new_value

            App.ActiveDocument.recompute()
            self.recompute()

        except Exception as e:
            print("Label OBJECT ERROR:", e)

            # --- Rollback dans l'arbre (comme avant) ---
            self._editing = True
            item.setText(1, old_value)  # colonne 1 = label
            self._editing = False

    def handle_cell_change(self, node, item, column, new_value, old_value):
        ref = node["ref"]
        sheet_name, local = ref.split(".")
        sheet = App.ActiveDocument.getObject(sheet_name)
        if not sheet:
            print("ERREUR: sheet not found :", sheet_name)
            return

        # ============================================================
        # === ALIAS ==================================================
        # ============================================================
        if column == 1:
            try:
                sheet.setAlias(local, new_value)
                App.ActiveDocument.recompute()
                self.recompute()

            except Exception as e:
                print("Alias ERROR:", e)

                # --- Rollback FreeCAD ---
                try:
                    if isinstance(old_value, str) and old_value.startswith("="):
                        sheet.setExpression(local, old_value.lstrip("="))
                    else:
                        sheet.set(local, old_value)

                    sheet.recompute()
                    App.ActiveDocument.recompute()

                finally:
                    # --- Rollback arbre ---
                    self._editing = True
                    item.setText(column, old_value)
                    self._editing = False

            return

        # ============================================================
        # === FORMULE ================================================
        # ============================================================
        if column == 3:
            try:
                # --- 1) État initial des objets invalides ---
                invalid_before = {
                    obj.Name
                    for obj in App.ActiveDocument.Objects
                    if hasattr(obj, "State") and "Invalid" in obj.State
                }

                # --- 2) Appliquer la formule ---
                sheet.set(local, new_value)
                sheet.recompute()

                # --- 3) Recompute global ---
                App.ActiveDocument.recompute()
                self.wait_for_recompute()

                # --- 4) État final ---
                invalid_after = {
                    obj.Name
                    for obj in App.ActiveDocument.Objects
                    if hasattr(obj, "State") and "Invalid" in obj.State
                }

                new_invalid = invalid_after - invalid_before

                # --- 5) Spreadsheet ou objets invalides ---
                if "Invalid" in sheet.State or new_invalid:
                    keep = ask_keep_invalid_change(
                        tr("spreadsheet_invalid_title"),
                        tr("spreadsheet_invalid_msg")
                    )
                    if not keep:
                        raise ValueError("Spreadsheet or dependent objects became invalid")

                    self.recompute()
                    return

                # --- 6) Vérifier ERR ---
                val = sheet.get(local)
                if isinstance(val, str) and val.startswith("ERR"):
                    raise ValueError("Invalid formula")

                # --- 7) OK ---
                self.recompute()

            except Exception as e:
                print("Formula CELL ERROR:", e)

                # --- Rollback FreeCAD ---
                try:
                    sheet.set(local, old_value)
                    sheet.recompute()
                    App.ActiveDocument.recompute()
                except Exception as e2:
                    print("ERROR restoring old cell formula:", e2)

                # --- Rollback arbre ---
                self._editing = True
                item.setText(column, old_value)
                self._editing = False

            return

    def on_item_changed(self, item, column):

        # --- 1) Filtrage technique ---
        if self._building or self._editing:
            return
        if column not in (1, 3):
            return

        # --- 2) Vérifier si la valeur a réellement changé ---
        new_value = item.text(column)
        old_value = self._old_value

        if old_value is None or new_value == old_value:
            return

        # --- 3) Traitement ---
        self._editing = True
        try:
            node_id = item.data(0, QtCore.Qt.UserRole)
            node = self.graph.get(node_id)
            if not node:
                return

            kind = node.get("kind")

            # 1) Formule sur propriété
            if kind == "property" and column == 3:
                return self.handle_property_formula(node, item, column, new_value, old_value)

            # 2) Label d’objet FreeCAD
            if kind == "property" and column == 1:
                return self.handle_object_label(node, new_value, old_value, item)

            # 3) Cellule Spreadsheet
            if kind == "cell":
                return self.handle_cell_change(node, item, column, new_value, old_value)

            # 4) Tout le reste : rien à faire
            return

        finally:
            # IMPORTANT : ce finally est correct et doit rester.
            self._editing = False
            self._old_value = None
            self._old_column = None


# ------------------------------------------------------------
# Sélections courantes (pour le bouton Relancer)
# ------------------------------------------------------------
def current_selected_property():
    # ex 'Pad.Length', ou None si aucune propriété n'est sélectionnée
    try:
        selected = selectedPropertyInPropertyView()
    except Exception:  # volontaire : simple aide au choix du point de départ
        return None
    return None if selected is None else selected.obj.Name + "." + selected.path


def current_selected_cells():
    # ex ('Spreadsheet', ('A1', 'B2')), ou None si la fenêtre active n'est pas un tableur
    try:
        view = Gui.ActiveDocument.ActiveView
        sheet = view.getSheet()
        cells = sheet.ViewObject.getView().selectedCells()
    except Exception:  # volontaire : vue 3D, pas de document...
        return None
    return (sheet.Name, tuple(str(c) for c in cells))


def current_selected_objects():
    # noms des objets sélectionnés (arbre FreeCAD ou vue 3D), ex ('Body',) ;
    # () si le document est sélectionné en haut de l'arbre = tout le document ;
    # None si rien n'est sélectionné ou s'il n'y a pas de document
    doc = App.ActiveDocument
    if doc is None:
        return None
    names = [o.Name for o in Gui.Selection.getSelection() if o.Document == doc]
    if names:
        return tuple(dict.fromkeys(names))  # sans doublon, dans l'ordre
    return () if document_selected_in_tree(doc) else None


# Type des lignes "document" de l'arbre FreeCAD (TreeWidget::DocumentType dans Tree.cpp)
TREE_DOCUMENT_ITEM_TYPE = 1000


def document_selected_in_tree(doc):
    # la ligne du document (tout en haut de l'arbre FreeCAD) est sélectionnée
    for tree in Gui.getMainWindow().findChildren(QtGui.QTreeWidget):
        if tree.metaObject().className() != "Gui::TreeWidget":
            continue
        for item in tree.selectedItems():
            if item.type() == TREE_DOCUMENT_ITEM_TYPE or item.text(0) == doc.Label:
                return True
    return False


def show_help():
    # Fenêtre d'aide : lancée sans rien de sélectionné (ou sans document ouvert)
    text = tr("help_text").format(wiki=__Wiki__)
    if Gui.ActiveDocument is None:
        text += "<p><b>" + tr("help_no_document") + "</b></p>"
    box = QtGui.QMessageBox(Gui.getMainWindow())
    box.setIcon(QtGui.QMessageBox.Information)
    box.setWindowTitle(f"{__Name__} ({__Version__})")
    box.setTextFormat(QtCore.Qt.RichText)
    box.setText(text)
    for label in box.findChildren(QtGui.QLabel):  # lien vers le wiki cliquable
        label.setOpenExternalLinks(True)
    box.exec()


# ------------------------------------------------------------
# Programme principal
# ------------------------------------------------------------
def property_view_has_focus():
    tree = Gui.getMainWindow().findChild(QtGui.QTreeView, "propertyEditorData")
    focus = QtGui.QApplication.focusWidget()
    return tree is not None and focus is not None and (focus is tree or tree.isAncestorOf(focus))


def property_view_has_selection():
    # une ligne est sélectionnée (en bleu) dans la fenêtre des propriétés
    tree = Gui.getMainWindow().findChild(QtGui.QTreeView, "propertyEditorData")
    return tree is not None and any(i.column() == 0 for i in tree.selectedIndexes())


def object_view_has_focus():
    # le focus est dans l'arbre FreeCAD ou dans une vue 3D
    widget = QtGui.QApplication.focusWidget()
    while widget is not None:
        if widget.metaObject().className() in ("Gui::TreeWidget", "Gui::View3DInventor"):
            return True
        widget = widget.parentWidget()
    return False


try:
    view = Gui.ActiveDocument.ActiveView
    sheet = view.getSheet()
except:
    sheet = None

# Point de départ :
# - une propriété : le focus est dans la fenêtre des propriétés, ou la fenêtre
#   active n'est pas un tableur (ex : vue 3D) et une propriété y est sélectionnée
# - sinon des objets : le focus est dans l'arbre FreeCAD ou une vue 3D, ou la fenêtre
#   active n'est pas un tableur ; le document sélectionné en haut de l'arbre = tout le document
# - sinon les cellules sélectionnées dans le tableur actif
# - rien de tout cela : fenêtre d'aide
root_property = None
root_objects = None
if Gui.ActiveDocument is not None:
    if property_view_has_focus() or (sheet is None and property_view_has_selection()):
        selected_property = selectedPropertyInPropertyView()
        if selected_property is not None:
            root_property = selected_property.obj.Name + "." + selected_property.path
    if root_property is None and (sheet is None or object_view_has_focus()):
        root_objects = current_selected_objects()

if root_objects is not None:
    dlg = RefDialog2(sheet, root_objects=root_objects)
    if object_root_refs(dlg.graph, objects_in_scope(root_objects)):
        QtGui.QApplication.instance().setProperty("qt_delay_before_tooltip", 200)
        dlg.show()
    else:
        QtGui.QMessageBox.information(
            None,
            tr("no_selection_title"),
            tr("object_no_dependency").format(obj=dlg.title_target())
        )
        dlg.deleteLater()  # fenêtre non affichée : arrêter son minuteur
elif root_property is not None:
    dlg = RefDialog2(sheet, root_property)
    if root_property in dlg.graph:
        QtGui.QApplication.instance().setProperty("qt_delay_before_tooltip", 200)
        dlg.show()
    else:
        QtGui.QMessageBox.information(
            None,
            tr("no_selection_title"),
            tr("property_no_dependency").format(prop=dlg.title_target())
        )
        dlg.deleteLater()  # fenêtre non affichée : arrêter son minuteur
elif sheet is None:
    show_help()
else:
    selected = sheet.ViewObject.getView().selectedCells()
    if not selected:
        QtGui.QMessageBox.information(
            None,
            tr("no_selection_title"),
            tr("no_selection_message")
        )
    else:
        QtGui.QApplication.instance().setProperty("qt_delay_before_tooltip", 200)
        dlg = RefDialog2(sheet)
        dlg.show()
